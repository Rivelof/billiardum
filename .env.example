# Образец .env для разработки (контракты M0 §3 и M1 §11). Значений здесь нет и быть не должно.
# `npm run dev` при первом запуске создаёт .env по этому файлу: секреты случайные,
# остальное — значения по умолчанию. .env не коммитится, значения секретов
# не выводятся в чат и логи (только длина).
#
# Адреса ниже — для процессов на хосте (миграции, сид, провижининг, `npm run sim`).
# Внутри Docker Compose хосты и пути заменяются: db:5432, mosquitto:8883, /repo/...
# Пароли базы и брокера применяются при первом создании их томов; после смены
# сотрите данные: `npm run down -- --volumes`.
# В уже существующий .env `npm run dev` дописывает недостающие переменные,
# имеющиеся значения не меняет.

# --- База: Postgres (образ supabase/postgres) ---

# Пароль суперпользователя supabase_admin (сервис db).
POSTGRES_PASSWORD=
# Подключение суперпользователя: миграции, сид, test:db.
# Вид: postgres://supabase_admin:<POSTGRES_PASSWORD>@localhost:54322/postgres
DATABASE_ADMIN_URL=
# Пароль рабочей роли app_api; его задаёт `npm run db:migrate`.
DB_APP_PASSWORD=
# Подключение сервера под app_api (без BYPASSRLS).
# Вид: postgres://app_api:<DB_APP_PASSWORD>@localhost:54322/postgres
DATABASE_URL=

# --- Брокер: Mosquitto, только TLS ---

# Адрес брокера, по умолчанию mqtts://localhost:8883.
MQTT_URL=
# CA брокера (создаёт scripts/dev-certs.mjs), по умолчанию deploy/dev/certs/ca.crt.
MQTT_CA_FILE=
# Администратор Dynamic Security: создаётся при первом старте брокера.
# Пользователь по умолчанию bl-admin, пароль не короче 12 символов.
MQTT_ADMIN_USER=
MQTT_ADMIN_PASSWORD=
# Учётная запись сервера в брокере (создаёт `npm run provision:dev`), по умолчанию bl-server.
MQTT_SERVER_USER=
MQTT_SERVER_PASSWORD=

# --- Секреты приложения ---

# Ключ AES-256-GCM для device_key и ключей ЮKassa в базе: 32 байта в base64 (decisions №23).
SECRETS_ENC_KEY=

# --- Симулятор контроллеров ---

# Устройства для симулятора (пишет `npm run provision:dev`), по умолчанию deploy/dev/devices.json.
SIM_DEVICES_FILE=

# --- Сервер ---

# Порт HTTP сервера, по умолчанию 3000.
PORT=
# Уровень логов: debug, info, warn, error. По умолчанию info.
LOG_LEVEL=

# --- Приложение (M1) ---

# Режим сервера, по умолчанию development. Вход для разработки и ускоренное время
# работают только не в production: там маршруты и ветки не регистрируются.
NODE_ENV=
# Хост и порт, под которыми сайт открывают браузер и телефон: ссылки в QR-наклейках
# (https://{PUBLIC_HOST}/t/{код}), return_url оплаты, страница эмулятора ЮKassa.
# По умолчанию localhost:8443. С телефона в локальной сети — см. DEV_LAN_HOST и README.
PUBLIC_HOST=
# Второй адрес сайта в Caddy для телефона в локальной сети: IP или имя этой машины
# (например 192.168.1.10). Пусто — только localhost.
DEV_LAN_HOST=
# 1 — вход по телефону без бота: POST /api/auth/dev (только не в production).
ALLOW_DEV_LOGIN=
# 1 — котировка на любое число минут от 1, чтобы проходить сценарии T3–T6 за минуты
# (только не в production, decisions №54).
DEV_ALLOW_ANY_MINUTES=
# Адреса прокси, от которых сервер принимает X-Forwarded-For, через запятую (CIDR).
# Пусто — частные сети Docker (там Caddy). В проде — адрес Caddy.
TRUSTED_PROXY_CIDRS=
# Адрес брокера, который сервер отдаёт контроллерам при привязке.
# Пусто — mqtts://{хост PUBLIC_HOST}:8883.
MQTT_PUBLIC_URL=

# --- Оплата: ЮKassa ---

# API ЮKassa. В разработке — эмулятор tools/yookassa-emu (http://yookassa-emu:8090/v3,
# только внутри Docker Compose), в проде — https://api.yookassa.ru/v3.
YOOKASSA_API_URL=
# Магазин эмулятора: shopId и секретный ключ, которые он принимает (Basic).
# provision:dev записывает их в настройки ЮKassa тестового клуба (шифруются SECRETS_ENC_KEY).
YOOKASSA_EMU_SHOP_ID=
YOOKASSA_EMU_SECRET=

# --- Уведомления: Web Push (VAPID) ---

# Пара ключей P-256 в base64url, как у Web Push: открытый — 65 байт (точка без сжатия),
# закрытый — 32 байта. npm run dev создаёт пару сам; меняются только вместе.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов, по умолчанию mailto:dev@localhost.
VAPID_SUBJECT=

# --- Боты мессенджеров (пусто — канал выключен, уведомления пишутся как skipped) ---

# Токен Telegram-бота от @BotFather и его имя без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет вебхука Telegram (secret_token в setWebhook), создаётся случайным.
TELEGRAM_WEBHOOK_SECRET=
# Прокси для api.telegram.org: с сервера в РФ он закрыт. Вид: http://… или socks5://…
TELEGRAM_PROXY_URL=
# Токен MAX-бота.
MAX_BOT_TOKEN=

# --- Публичный сайт: web/site (M4) ---

# Публичный адрес сайта для канонических ссылок, sitemap.xml и OG-картинок, со схемой:
# https://billiardum.ru. Пусто — https://{PUBLIC_HOST}.
SITE_ORIGIN=
# Номер счётчика Яндекс Метрики (только цифры). Пусто — счётчика на сайте нет.
# Только сайт: в приложениях гостя и клуба аналитики нет, Вебвизор на формах выключен.
YANDEX_METRIKA_ID=
# Код подтверждения Яндекс Вебмастера (meta yandex-verification). Пусто — нет.
YANDEX_VERIFICATION=
# 1 — запретить индексацию (стенды): robots.txt Disallow: /, meta robots noindex.
BL_SITE_NOINDEX=
# Подсеть Docker site-api, где только server и site (deploy/dev/compose.yml).
# Пусто — 10.231.47.0/29. Менять, только если пересекается с вашей сетью или VPN;
# после смены: npm run down, затем npm run dev.
SITE_API_SUBNET=
# Адреса (CIDR через запятую), с которых публичный API /api/public/* работает без лимита
# 120 запросов в минуту с IP: сервис сайта. Пусто — подсеть SITE_API_SUBNET.
# Адрес Caddy сюда не добавлять: иначе лимит снимется для всех браузеров.
PUBLIC_API_TRUSTED_CIDRS=
# Подсеть Docker site-web, где только caddy и site. Пусто — 10.231.47.8/29.
# Менять, только если пересекается с вашей сетью или VPN (затем npm run down и npm run dev).
SITE_WEB_SUBNET=
# Прокси (CIDR через запятую), от которых сайт верит X-Forwarded-For — IP гостя для лимита
# заявок. Пусто — подсеть SITE_WEB_SUBNET (там только Caddy). В проде — адрес Caddy.
SITE_TRUSTED_PROXIES=
