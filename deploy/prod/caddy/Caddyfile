# Caddy прода «Бильярдума» (deploy/prod/compose.yml). Свой домен BL_DOMAIN, TLS от Let's Encrypt.
#
#   /api/*, /t/*, /health → server-web:3000 (SSE и WebSocket моста ККТ — без буферизации)
#   /app/*                → сборка web/guest (том web-static, кладёт web-publish)
#   /club/*               → сборка web/admin
#   всё остальное         → site:3100, публичный сайт-агрегатор
#
# Отличия от deploy/dev/Caddyfile: настоящий сертификат вместо tls internal, нет /pay/*
# (страница оплаты — у самой ЮKassa), нет второго адреса для телефона, HSTS всегда, вебхуки
# ЮKassa — только с её адресов (YOOKASSA_WEBHOOK_IPS).
#
# Порт 80 наружу не открыт: сертификат выпускается проверкой TLS-ALPN-01 на 443. Поэтому
# http://… не перенаправляется — QR-наклейки и ссылки всегда https://.
#
# Правка этого файла применяется без перезапуска: deploy/prod/bin/caddy-reload.sh
# (caddy reload; мосты ККТ получают 5 минут на переподключение — stream_close_delay).

{
	email {$ACME_EMAIL}
	# Только TLS-ALPN-01 (порт 443): порт 80 закрыт.
	cert_issuer acme {
		disable_http_challenge
	}
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# Заголовки безопасности для всех ответов (defer — поверх заголовков сервера и сайта).
# Referrer-Policy same-origin: пути с кодом стола не уходят чужим сайтам, а свои POST
# сохраняют Origin, по которому сервер проверяет запросы с cookie.
(security) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	# Камера — только программе клуба: сканер QR на корпусе контроллера (M5.1 №159).
	@club path /club /club/*
	header @club Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
	@not_club not path /club /club/*
	header @not_club Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
}

# CSP приложений: всё только со своего хоста (decisions №22), без inline-скриптов и стилей.
# Аргумент — frame-ancestors.
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors {args[0]}"
}

# Статическая сборка Vite с откатом на index.html для маршрутов SPA.
(spa) {
	encode zstd gzip

	@nobuild not file /index.html
	handle @nobuild {
		header Cache-Control "no-store"
		respond "Сервис обновляется, попробуйте через минуту." 503
	}

	# Ассеты с хешем в имени не меняются — кэш на год. Старые ассеты web-publish хранит
	# 14 дней: открытая вкладка со старой версией догружает свои файлы.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@file path_regexp \.[A-Za-z0-9]+$
	handle @file {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Ответы сервера: свои Cache-Control и CSP главнее (?). Тело запроса — не больше 1 МБ.
(api) {
	header {
		?Cache-Control "no-store"
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}
	request_body {
		max_size 1MB
	}
}

{$BL_DOMAIN} {
	import security

	redir /app /app/ 308
	redir /club /club/ 308

	# Вебхуки ЮKassa (магазины клубов и магазин платформы, M5.3): только с адресов ЮKassa.
	# Платёж сервер всё равно перепроверяет запросом в ЮKassa; список — защита от мусора.
	@yookassa_webhook path /api/webhooks/yookassa/* /api/webhooks/yookassa-platform /api/webhooks/yookassa-platform/*
	handle @yookassa_webhook {
		@foreign not remote_ip {$YOOKASSA_WEBHOOK_IPS}
		respond @foreign 403
		import api
		reverse_proxy server-web:3000
	}

	# Потоки событий (SSE): каждое событие уходит клиенту сразу.
	@sse path /api/stream* /api/public/stream*
	handle @sse {
		import api
		reverse_proxy server-web:3000 {
			flush_interval -1
		}
	}

	# Мост ККТ с ПК ресепшена (decisions №77): WebSocket на часы и дни, без буфера и лимита
	# тела. stream_close_delay: перезагрузка конфига Caddy не рвёт мосты сразу.
	handle /api/kkt/ws {
		header {
			?Cache-Control "no-store"
			?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}
		reverse_proxy server-web:3000 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	@server path /api/* /t/* /health
	handle @server {
		import api
		reverse_proxy server-web:3000
	}

	# Приложение гостя: во фрейме — только веб-версии мессенджеров (мини-приложения).
	handle_path /app/* {
		root * /srv/web/guest
		import csp "'self' https://web.telegram.org https://web.max.ru"
		import spa
	}

	# Программа клуба: никогда во фрейме (кликджекинг на кнопках персонала).
	handle_path /club/* {
		root * /srv/web/admin
		import csp "'none'"
		import spa
	}

	# Публичный сайт: всё остальное. CSP, Cache-Control и сжатие сайт ставит сам.
	handle {
		encode zstd gzip
		header /assets/* {
			defer
			Cache-Control "public, max-age=31536000, immutable"
		}
		header {
			?Cache-Control "no-cache"
			?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		request_body {
			max_size 64KB
		}
		reverse_proxy site:3100
	}
}
