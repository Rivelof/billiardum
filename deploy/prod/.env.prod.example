# Образец настроек прода «Бильярдума» (deploy/prod/compose.yml, docs/deploy/RUNBOOK.md §4.3).
# На сервере — /etc/billiardum/prod.env, владелец root, права 0600. Создаёт его
# deploy/prod/bin/gen-env.sh: секреты случайные, остальное — из этого файла.
# Секретов здесь нет и быть не должно: пустые строки — то, что задаётся на сервере.
# Значения секретов не выводятся в чат и логи (только длина: preflight.sh).
# Комментарии — только целой строкой (не после значения). Кавычки не нужны.
# Проверка: deploy/prod/bin/preflight.sh; образец проверяет scripts/ci-prod-config.test.mjs.

# --- Выпуск ---

# Выпуск приложения (git sha образа billiardum-app). Пишет deploy.sh, руками не менять.
BL_RELEASE=

# --- Домен (решение Андрея, PRODUCT §22.6) ---

# Домен сайта, приложений и API без схемы: billiardum.ru. Сертификат — Let's Encrypt (TLS-ALPN-01 на 443).
BL_DOMAIN=
# Почта для Let's Encrypt (уведомления о сертификате).
ACME_EMAIL=
# Канонический адрес сайта: https://{BL_DOMAIN}.
SITE_ORIGIN=
# Брокер для контроллеров (ответ claim): отдельное имя с A-записью на этот сервер,
# в сертификате брокера (mqtt-certs.sh issue … mqtt.{домен}).
MQTT_PUBLIC_URL=

# --- Окно обслуживания (CLAUDE.md: брокер не перезапускается в часы работы клубов) ---

# Когда клубы закрыты: перезапуск брокера и базы, обновление Docker и ядра — только тогда.
# ЧЧ:ММ-ЧЧ:ММ по поясу пилотного клуба; сверить с часами работы клуба.
MAINTENANCE_WINDOW=06:00-10:00
MAINTENANCE_TZ=Europe/Moscow

# --- Пути на сервере ---

BL_STATE_DIR=/var/lib/billiardum
BL_MQTT_CERTS_DIR=/etc/billiardum/mqtt

# --- Сети Docker и доверенные прокси (decisions №70, M4-I4) ---
# У каждой пары «прокси → сервис» своя сеть /29 с фиксированными адресами. Сервер верит
# X-Forwarded-For (IP гостя для лимитов) только от Caddy и сайта, сайт — только от Caddy.
# Менять, только если подсети пересекаются с сетью хостинга; тогда — все адреса и списки ниже.

# caddy → server
SERVER_WEB_SUBNET=10.231.48.16/29
SERVER_WEB_SERVER_IP=10.231.48.21
SERVER_WEB_CADDY_IP=10.231.48.22
# site → server
SITE_API_SUBNET=10.231.48.0/29
SITE_API_SERVER_IP=10.231.48.5
SITE_API_SITE_IP=10.231.48.6
# caddy → site
SITE_WEB_SUBNET=10.231.48.8/29
SITE_WEB_CADDY_IP=10.231.48.13
SITE_WEB_SITE_IP=10.231.48.14
# База (без выхода наружу), Caddy (порт 443), брокер (порт 8883) и выход сервера в интернет.
DB_NET_SUBNET=10.231.48.32/28
EDGE_WEB_SUBNET=10.231.48.48/28
EDGE_MQTT_SUBNET=10.231.48.64/28

# Ровно адрес Caddy в server-web и адрес сайта в site-api, /32. Не частные сети: иначе сосед
# по сети подставит X-Forwarded-For и снимет лимиты (pentester L1, M1).
TRUSTED_PROXY_CIDRS=10.231.48.22/32,10.231.48.6/32
# Только адрес сайта: с него публичный API без лимита 120 запросов в минуту с IP.
# Адрес Caddy сюда нельзя — лимит снимется для всех браузеров.
PUBLIC_API_TRUSTED_CIDRS=10.231.48.6/32
# Только адрес Caddy в site-web.
SITE_TRUSTED_PROXIES=10.231.48.13/32

# Адреса, с которых ЮKassa шлёт вебхуки (Caddy пускает к /api/webhooks/yookassa* только их).
# Через пробел. Сверить с документацией ЮKassa перед пилотом: yookassa.ru/developers, «Входящие уведомления».
YOOKASSA_WEBHOOK_IPS=185.71.76.0/27 185.71.77.0/27 77.75.153.0/25 77.75.156.11/32 77.75.156.35/32 77.75.154.128/25 2a02:5180::/32

# --- База: Postgres (supabase/postgres), наружу не открыта ---

# Пароль supabase_admin (миграции, бэкапы). Только [A-Za-z0-9_-], от 32 символов.
POSTGRES_PASSWORD=
# Пароль рабочей роли app_api (без BYPASSRLS). Только [A-Za-z0-9_-], от 32 символов.
DB_APP_PASSWORD=
# Память Postgres: четверть и три четверти ОЗУ сервера (для 4 ГБ — 1GB и 3GB).
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

# --- Брокер: Mosquitto, TLS и Dynamic Security ---

# Администратор Dynamic Security: создаётся при первом старте брокера; им же сервер привязывает
# контроллеры. Смена пароля — только в окне обслуживания (RUNBOOK §8).
MQTT_ADMIN_USER=bl-admin
MQTT_ADMIN_PASSWORD=
# Учётная запись сервера (bl/v1/#), создаёт mqtt-server-client.mjs.
MQTT_SERVER_USER=bl-server
MQTT_SERVER_PASSWORD=

# --- Секреты приложения ---

# AES-256-GCM для device_key контроллеров и ключей ЮKassa клубов в базе: 32 байта в base64
# (decisions №23). Без него дамп базы бесполезен, но и потеря = перепривязка всех контроллеров
# и повторный ввод ключей ЮKassa клубами: копия — у Андрея (RUNBOOK §7.4).
SECRETS_ENC_KEY=

# --- Оплата: ЮKassa ---
# Магазины клубов (shopId и секретный ключ) здесь НЕ задаются: каждый клуб вводит свои в
# мастере подключения, сервер хранит их в базе зашифрованными SECRETS_ENC_KEY (№154).
# Адрес API в проде один — https://api.yookassa.ru/v3, он задан в compose.yml.

# Магазин платформы для подписки клубов (M5.3, №183): автоплатежи, чеки за программу.
# До выкатки M5.3 не используется. Боевой секрет начинается с live_.
PLATFORM_YOOKASSA_SHOP_ID=
PLATFORM_YOOKASSA_SECRET=
# Чек за подписку (server/billing/config.mjs): ставка НДС позиции (1–12, пусто — 1, без НДС) и
# система налогообложения юрлица платформы (1–6). Задаёт бухгалтер Андрея.
PLATFORM_VAT_CODE=
PLATFORM_TAX_SYSTEM_CODE=
# Куда ЮKassa вернёт владельца после оплаты. Пусто — https://{BL_DOMAIN}/club/subscription.
# В кабинете магазина платформы адрес уведомлений — https://{BL_DOMAIN}/api/webhooks/yookassa-platform.
PLATFORM_BILLING_RETURN_URL=

# --- Подключение клуба и согласия ---

# Версия оферты платформы (M5.1 №160) и согласия на обработку ПДн. Пусто — версии по
# умолчанию сервера; новая версия — когда меняется текст в docs/legal/.
CLUB_OFFER_VERSION=
CONSENT_VERSION=

# --- Уведомления ---

# Web Push (VAPID, P-256, base64url): открытый 65 байт, закрытый 32 байта. gen-env.sh создаёт пару.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов: mailto:{почта платформы}.
VAPID_SUBJECT=
# Telegram-бот платформы (@BotFather): вход гостей и тревоги Андрею.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# secret_token вебхука (16–256 символов), gen-env.sh создаёт случайный.
TELEGRAM_WEBHOOK_SECRET=
# Прокси для api.telegram.org — с сервера в РФ он закрыт. http://… или socks5://…
TELEGRAM_PROXY_URL=
# MAX-бот (основной канал). Адаптер сервера пока заглушка: нет документации API MAX.
MAX_BOT_TOKEN=

# --- Публичный сайт ---

# Яндекс Метрика — только на сайте, без Вебвизора на формах (№141). Номер счётчика, цифры.
YANDEX_METRIKA_ID=
# Код подтверждения Яндекс Вебмастера.
YANDEX_VERIFICATION=
# 1 — закрыть от индексации (только стенд). В проде пусто.
BL_SITE_NOINDEX=
BL_SITE_RATE_PER_MIN=120

# --- Логи ---

LOG_LEVEL=info

# --- Бэкапы (RUNBOOK §7): хранилище S3 в РФ, шифрование age ---

# Куда: «remote:bucket/папка» rclone. Хранилище — у другого провайдера в РФ, чем сервер
# (Yandex Object Storage, Selectel, VK Cloud — проверить по договору, что ЦОД в РФ).
BACKUP_RCLONE_REMOTE=blbackup:billiardum-backup/prod
# Настройки remote «blbackup» для rclone (без файла rclone.conf). Ключ — с правами только
# на запись и чтение, без удаления; хранение 35 дней — правилом жизненного цикла бакета.
RCLONE_CONFIG_BLBACKUP_TYPE=s3
RCLONE_CONFIG_BLBACKUP_PROVIDER=Other
RCLONE_CONFIG_BLBACKUP_ENDPOINT=
RCLONE_CONFIG_BLBACKUP_REGION=
RCLONE_CONFIG_BLBACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BLBACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BLBACKUP_NO_CHECK_BUCKET=true
# Открытые ключи age, через пробел: ключ Андрея (закрытый — только офлайн у него) и ключ
# проверки восстановления (закрытый — ниже). Бэкап базы и брокера шифруется для обоих.
BACKUP_AGE_RECIPIENTS=
# Закрытый ключ проверки восстановления (age-keygen): ежемесячная проверка расшифровывает им.
BACKUP_RESTORE_AGE_KEY=
# Открытый ключ Андрея: копия этого файла настроек шифруется только для него (№23: ключ
# SECRETS_ENC_KEY не лежит рядом с бэкапом базы в открытом виде).
BACKUP_ENV_AGE_RECIPIENT=

# --- Монитор и тревоги (RUNBOOK §6) ---

# Куда слать тревоги: id чатов Андрея с ботом платформы (через запятую). Как узнать — RUNBOOK §6.
MONITOR_TELEGRAM_CHAT_IDS=
# Зарезервировано под MAX, когда появится адаптер.
MONITOR_MAX_USER_IDS=
MONITOR_TZ=Europe/Moscow
# Часы, когда контроллеры должны быть на связи (ЧЧ-ЧЧ, местное время): ночью зал могут обесточивать.
MONITOR_DEVICE_HOURS=10-02
MONITOR_DEVICES_MIN_ONLINE_PCT=90
MONITOR_DISK_WARN_PCT=80
MONITOR_DISK_CRIT_PCT=90
# Напоминание о неисправленной проблеме, минут.
MONITOR_REPEAT_MIN=60
