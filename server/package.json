{
  "name": "@billiardum/server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер «Бильярдума»: HTTP, мост MQTT, подпись команд контроллеру",
  "type": "module",
  "main": "index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test \"test/*.test.mjs\" \"tariffs/test/*.test.mjs\" \"payments/test/*.test.mjs\"",
    "provision:dev": "node bin/provision-dev.mjs",
    "test:db": "node --test --test-concurrency=1 \"test/db/*.test.mjs\""
  },
  "dependencies": {
    "@billiardum/shared": "0.1.0",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "jsqr": "1.4.0"
  }
}
