{
  "name": "@billiardum/server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер «Бильярдума»: HTTP, мост MQTT, подпись команд контроллеру",
  "type": "module",
  "main": "index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test \"test/*.test.mjs\" \"tariffs/test/*.test.mjs\" \"payments/test/*.test.mjs\" \"kkt/test/*.test.mjs\" \"shifts/test/*.test.mjs\" \"reports/test/*.test.mjs\" \"catalog/test/*.test.mjs\" \"orders/test/*.test.mjs\" \"stock/test/*.test.mjs\" \"plus/test/*.test.mjs\" \"tournaments/test/*.test.mjs\" \"setup/test/*.test.mjs\" \"clubs/test/*.test.mjs\" \"dashboard/test/*.test.mjs\" \"billing/test/*.test.mjs\" \"clubapi/test/*.test.mjs\" \"maintenance/test/*.test.mjs\"",
    "provision:dev": "node bin/provision-dev.mjs",
    "test:db": "node --test --test-concurrency=1 \"test/db/*.test.mjs\" \"kkt/test/db/*.test.mjs\" \"catalog/test/db/*.test.mjs\" \"orders/test/db/*.test.mjs\" \"stock/test/db/*.test.mjs\" \"plus/test/db/*.test.mjs\""
  },
  "dependencies": {
    "@billiardum/shared": "0.1.0",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "uqr": "0.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "jsqr": "1.4.0"
  }
}
