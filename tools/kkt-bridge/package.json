{
  "name": "@billiardum/kkt-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Мост ККТ «Бильярдума»: ПК ресепшена ↔ сервер (WebSocket) ↔ веб-сервер драйвера АТОЛ; эмулятор веб-сервера АТОЛ",
  "type": "module",
