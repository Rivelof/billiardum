{
  "name": "Команда сразу ставит остаток ниже порога",
  "description": "Сигнал текущей фазы звучит один раз сразу: ниже warn_ms[0] — индикатор и 2 сигнала, ниже warn_ms[1] — только двойное мигание.",
  "steps": [
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000004", "remaining_ms": 200000, "buzzer": true } },
    { "expect": { "mode": "ending", "led": "yellow_blink", "lamp": true, "signals": { "warn": 1, "beep": 2, "blink2": 0 } } },
    { "advance_ms": 140000 },
    { "expect": { "mode": "ending", "remaining_ms": 60000, "lamp": false, "signals": { "warn": 1, "blink2": 1 } } },
    { "cmd": "state.free" },
    { "expect": { "mode": "free", "relay": false, "lamp": false, "session_id": null, "nvs_session": null } },
    { "cmd": "session.resume", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000005", "remaining_ms": 30000, "buzzer": true } },
    { "expect": { "mode": "ending", "relay": true, "lamp": false, "remaining_ms": 30000, "signals": { "warn": 1, "beep": 2, "blink2": 2 } } },
    { "advance_ms": 900 },
    { "expect": { "lamp": true } },
    { "advance_ms": 29100 },
    { "expect": { "mode": "grace", "remaining_ms": 0, "signals": { "grace": 1, "grace_blink": 1 } } },
    { "events": ["boot"] }
  ]
}
