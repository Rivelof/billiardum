{
  "name": "Неисправная лампа: lamp_fault по current_confirm_ms",
  "description": "Реле включено, тока нет дольше current_confirm_ms — lamp_fault один раз; сессия идёт дальше. Время подтверждения задаёт config.set.",
  "steps": [
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000021", "remaining_ms": 3600000, "buzzer": true } },
    { "fault": "lamp-fault", "on": true },
    { "expect": { "mode": "active", "relay": true, "current_ma": 0 } },
    { "advance_ms": 9999 },
    { "events": ["boot"] },
    { "advance_ms": 1 },
    { "expect": { "mode": "active", "relay": true, "led": "off", "remaining_ms": 3590000 } },
    { "events": [{ "type": "lamp_fault", "at_uptime_ms": 10000, "data": { "current_ma": 0 } }] },
    { "advance_ms": 30000 },
    { "events": [] },
    { "fault": "lamp-fault", "on": false },
    { "expect": { "current_ma": 400 } },
    { "cmd": "config.set", "body": { "current_confirm_ms": 5000 } },
    { "fault": "lamp-fault", "on": true },
    { "advance_ms": 4999 },
    { "events": [] },
    { "advance_ms": 1 },
    { "events": ["lamp_fault"] },
    { "cmd": "session.stop", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000021", "reason_code": "lamp_broken" } },
    { "expect": { "mode": "free", "relay": false, "current_ma": 0 } },
    { "advance_ms": 60000 },
    { "events": [] },
    { "cmd": "service.start", "body": { "duration_ms": 60000, "reason_code": "repair" } },
    { "advance_ms": 5000 },
    { "expect": { "mode": "service", "relay": true } },
    { "events": ["lamp_fault"] },
    { "advance_ms": 55000 },
    { "expect": { "mode": "free" } },
    { "events": [] }
  ]
}
