{
  "name": "Перезагрузка в льготу; ответ state.free; новая сессия в окне ожидания",
  "description": "Перезагрузка в grace без сервера — free без события (остаток 0); сервер ответил state.free — сессия из NVS стирается; session.start с другой сессией в окне заменяет сессию в NVS.",
  "steps": [
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000011", "remaining_ms": 60000, "warn_ms": [30000, 10000], "grace_ms": 120000, "buzzer": true } },
    { "advance_ms": 70000 },
    { "expect": { "mode": "grace", "nvs_session": { "remaining_ms": 0 } } },
    { "reboot": true },
    { "advance_ms": 30000 },
    { "expect": { "mode": "free", "relay": false, "nvs_session": null } },
    { "events": ["boot", "boot"] },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000012", "remaining_ms": 600000, "buzzer": true } },
    { "advance_ms": 61000 },
    { "reboot": true },
    { "advance_ms": 2000 },
    { "cmd": "state.free" },
    { "expect": { "mode": "free", "relay": false, "nvs_session": null } },
    { "advance_ms": 30000 },
    { "expect": { "mode": "free", "relay": false } },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000013", "remaining_ms": 600000, "buzzer": true } },
    { "advance_ms": 61000 },
    { "reboot": true },
    { "expect": { "nvs_session": { "session_id": "0192f3c0-0000-7000-8000-000000000013", "remaining_ms": 540000 } } },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000014", "remaining_ms": 3600000, "buzzer": true } },
    { "expect": { "mode": "active", "session_id": "0192f3c0-0000-7000-8000-000000000014",
      "nvs_session": { "session_id": "0192f3c0-0000-7000-8000-000000000014", "remaining_ms": 3600000, "offline_resumes": 0 } } },
    { "advance_ms": 30000 },
    { "expect": { "mode": "active", "remaining_ms": 3570000, "session_id": "0192f3c0-0000-7000-8000-000000000014" } },
    { "events": ["boot", "boot"] }
  ]
}
