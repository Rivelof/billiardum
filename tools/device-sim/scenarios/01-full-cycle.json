{
  "name": "Старт → T−5 → T−1 → льгота → free",
  "description": "Сигналы по умолчанию: warn_ms [300000, 60000], grace_ms 120000, лампа без диммера мигает раз в 15 с. Связь есть, offline_session_finished нет.",
  "steps": [
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000001", "remaining_ms": 600000, "buzzer": true } },
    { "expect": { "mode": "active", "relay": true, "lamp": true, "dim": 100, "led": "off", "buzzer": true, "remaining_ms": 600000,
      "session_id": "0192f3c0-0000-7000-8000-000000000001", "current_ma": 400, "last_seq": 1,
      "signals": { "warn": 0, "beep": 0, "blink2": 0, "grace": 0, "grace_blink": 0 },
      "nvs_session": { "session_id": "0192f3c0-0000-7000-8000-000000000001", "remaining_ms": 600000, "warn_ms": [300000, 60000], "grace_ms": 120000, "buzzer": true, "offline_resumes": 0 } } },
    { "advance_ms": 299999 },
    { "expect": { "mode": "active", "led": "off", "remaining_ms": 300001, "signals": { "warn": 0 }, "nvs_session": { "remaining_ms": 360000 } } },
    { "advance_ms": 1, "note": "T−5: остаток пересёк warn_ms[0]" },
    { "expect": { "mode": "ending", "led": "yellow_blink", "relay": true, "lamp": true, "remaining_ms": 300000,
      "signals": { "warn": 1, "beep": 2, "blink2": 0 }, "nvs_session": { "remaining_ms": 300000 } } },
    { "advance_ms": 239999 },
    { "expect": { "mode": "ending", "remaining_ms": 60001, "lamp": true, "signals": { "blink2": 0 }, "nvs_session": { "remaining_ms": 120000 } } },
    { "advance_ms": 1, "note": "T−1: лампа дважды мигает — выкл. 300, вкл. 300, выкл. 300" },
    { "expect": { "mode": "ending", "relay": true, "lamp": false, "remaining_ms": 60000, "signals": { "warn": 1, "beep": 2, "blink2": 1 } } },
    { "advance_ms": 300 },
    { "expect": { "lamp": true } },
    { "advance_ms": 300 },
    { "expect": { "lamp": false } },
    { "advance_ms": 300 },
    { "expect": { "lamp": true, "relay": true } },
    { "advance_ms": 59100, "note": "T−0: льгота, индикатор красный, мигание раз в 15 с" },
    { "expect": { "mode": "grace", "led": "red", "relay": true, "lamp": false, "dim": 100, "remaining_ms": 0,
      "signals": { "grace": 1, "grace_blink": 1 }, "nvs_session": { "remaining_ms": 0 } } },
    { "advance_ms": 300 },
    { "expect": { "lamp": true } },
    { "advance_ms": 119699 },
    { "expect": { "mode": "grace", "lamp": true, "signals": { "grace_blink": 8 } } },
    { "advance_ms": 1, "note": "grace_ms истёк: свет гаснет" },
    { "expect": { "mode": "free", "relay": false, "lamp": false, "dim": 0, "led": "green_dim", "buzzer": false, "remaining_ms": null,
      "session_id": null, "current_ma": 0, "nvs_session": null,
      "signals": { "warn": 1, "beep": 2, "blink2": 1, "grace": 1, "grace_blink": 8 } } },
    { "events": [ { "type": "boot", "boot": 1, "n": 1, "data": { "reset_reason": "poweron" } } ] }
  ]
}
