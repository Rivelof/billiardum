{
  "name": "pending и reserved истекают сами",
  "description": "state.pending (белый мигает) и state.reserved (синий) без света; по истечении until_ms — free; session.start принимается из обоих (T12).",
  "steps": [
    { "cmd": "state.pending", "body": { "until_ms": 180000 } },
    { "expect": { "mode": "pending", "relay": false, "lamp": false, "led": "white_blink", "remaining_ms": null, "session_id": null } },
    { "advance_ms": 179999 },
    { "expect": { "mode": "pending" } },
    { "advance_ms": 1 },
    { "expect": { "mode": "free", "led": "green_dim" } },
    { "cmd": "state.reserved", "body": { "until_ms": 900000 } },
    { "expect": { "mode": "reserved", "relay": false, "led": "blue" } },
    { "advance_ms": 1000 },
    { "cmd": "state.pending", "body": { "until_ms": 180000 } },
    { "expect": { "mode": "pending", "led": "white_blink" } },
    { "advance_ms": 1000 },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000016", "remaining_ms": 3600000, "buzzer": true } },
    { "expect": { "mode": "active", "relay": true, "led": "off" } },
    { "advance_ms": 179000 },
    { "expect": { "mode": "active", "remaining_ms": 3421000 } },
    { "cmd": "session.stop", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000016", "reason_code": "guest_finished" } },
    { "cmd": "state.reserved", "body": { "until_ms": 60000 } },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000017", "remaining_ms": 3600000, "buzzer": false } },
    { "expect": { "mode": "active", "relay": true } },
    { "advance_ms": 60000 },
    { "expect": { "mode": "active", "relay": true } },
    { "cmd": "state.free" },
    { "cmd": "state.pending", "body": { "until_ms": 60000 } },
    { "cmd": "state.free" },
    { "expect": { "mode": "free" } },
    { "advance_ms": 60000 },
    { "expect": { "mode": "free" } },
    { "cmd": "state.reserved", "body": { "until_ms": 1000 } },
    { "advance_ms": 1000 },
    { "expect": { "mode": "free", "relay": false } },
    { "events": ["boot"] }
  ]
}
