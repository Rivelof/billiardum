{
  "name": "Свет в обход: bypass_detected и fault",
  "description": "Ток при выключенном реле дольше current_confirm_ms — событие bypass_detected один раз, состояние fault (индикатор red_fast) поверх free/pending/reserved; ток пропал — free; порог и время — config.set (T10).",
  "steps": [
    { "fault": "bypass", "on": true },
    { "expect": { "mode": "free", "relay": false, "current_ma": 380 } },
    { "advance_ms": 9999 },
    { "expect": { "mode": "free" } },
    { "events": ["boot"] },
    { "advance_ms": 1 },
    { "expect": { "mode": "fault", "relay": false, "lamp": false, "led": "red_fast", "dim": 0 } },
    { "events": [{ "type": "bypass_detected", "at_uptime_ms": 10000, "data": { "current_ma": 380 } }] },
    { "advance_ms": 60000 },
    { "events": [] },
    { "cmd": "state.pending", "body": { "until_ms": 60000 } },
    { "expect": { "mode": "fault", "led": "red_fast" } },
    { "cmd": "ota.start", "body": { "url": "https://billiardum.ru/fw/1.0.4.bin", "version": "1.0.4", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "image_sig": "AA==" }, "ack": "busy_ota" },
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000020", "remaining_ms": 600000, "buzzer": true } },
    { "expect": { "mode": "active", "relay": true, "lamp": true, "led": "off", "current_ma": 400 } },
    { "advance_ms": 10000 },
    { "cmd": "session.stop", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000020", "reason_code": "guest_finished" } },
    { "expect": { "mode": "free", "relay": false, "current_ma": 380 } },
    { "advance_ms": 10000 },
    { "expect": { "mode": "fault" } },
    { "events": ["bypass_detected"] },
    { "fault": "bypass", "on": false },
    { "expect": { "mode": "free", "led": "green_dim", "current_ma": 0 } },
    { "cmd": "config.set", "body": { "current_confirm_ms": 2000 } },
    { "fault": "bypass", "on": true },
    { "advance_ms": 1999 },
    { "expect": { "mode": "free" } },
    { "advance_ms": 1 },
    { "expect": { "mode": "fault" } },
    { "events": ["bypass_detected"] },
    { "cmd": "config.set", "body": { "current_on_ma": 500 } },
    { "expect": { "mode": "free", "current_ma": 380 } },
    { "advance_ms": 60000 },
    { "events": [] }
  ]
}
