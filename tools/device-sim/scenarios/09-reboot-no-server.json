{
  "name": "Перезагрузка без сервера: один раз «сохранённый − S», второй раз — free",
  "description": "Правило 4 (decisions №30): нет ответа 30 с — остаток сохранённый минус 60 с, offline_resumes = 1, событие offline_resume; вторая перезагрузка без сервера — free и offline_resume_denied; третья — сессии в NVS нет.",
  "steps": [
    { "cmd": "session.start", "body": { "session_id": "0192f3c0-0000-7000-8000-000000000010", "remaining_ms": 600000, "buzzer": false } },
    { "advance_ms": 130000 },
    { "net": false },
    { "reboot": true },
    { "advance_ms": 29999 },
    { "expect": { "mode": "free", "relay": false, "boot": 2, "nvs_session": { "remaining_ms": 480000, "offline_resumes": 0 } } },
    { "advance_ms": 1 },
    { "expect": { "mode": "active", "relay": true, "remaining_ms": 420000, "session_id": "0192f3c0-0000-7000-8000-000000000010", "buzzer": false,
      "nvs_session": { "remaining_ms": 420000, "offline_resumes": 1 } } },
    { "events": ["boot", { "type": "boot", "boot": 2 },
      { "type": "offline_resume", "boot": 2, "n": 2, "at_uptime_ms": 30000,
        "data": { "session_id": "0192f3c0-0000-7000-8000-000000000010", "saved_ms": 480000, "resumed_ms": 420000 } }] },
    { "advance_ms": 100000 },
    { "expect": { "mode": "active", "remaining_ms": 320000, "nvs_session": { "remaining_ms": 360000, "offline_resumes": 1 } } },
    { "reboot": true },
    { "advance_ms": 29999 },
    { "expect": { "mode": "free", "boot": 3, "nvs_session": { "offline_resumes": 1 } } },
    { "advance_ms": 1 },
    { "expect": { "mode": "free", "relay": false, "nvs_session": null, "outbox": ["boot", "offline_resume", "boot", "offline_resume_denied"] } },
    { "events": [{ "type": "boot", "boot": 3 }, { "type": "offline_resume_denied", "data": { "session_id": "0192f3c0-0000-7000-8000-000000000010" } }] },
    { "reboot": true },
    { "advance_ms": 60000 },
    { "expect": { "mode": "free", "relay": false, "boot": 4, "nvs_session": null } },
    { "net": true },
    { "expect": { "outbox": [] } },
    { "events": [{ "type": "boot", "boot": 4 }] }
  ]
}
