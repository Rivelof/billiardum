# Зависимости
node_modules/

# Секреты: только в .env, в репозиторий не попадают
.env
.env.*
!.env.example

# Блокировка npm для параллельной работы агентов
.npm.lock

# Окружение разработки (deploy/dev): сертификаты, секреты устройств, данные
deploy/dev/certs/
deploy/dev/devices.json
deploy/dev/kkt-bridge.token
# Отпечатки кода запущенных контейнеров (npm run dev, scripts/dev-code.mjs)
deploy/dev/code-state.json*
deploy/dev/kkt-bridge-data/
deploy/dev/data/
deploy/dev/**/*.log

# Логи
*.log
logs/
npm-debug.log*

# Сборка и отчёты
coverage/
# Отчёты Lighthouse сайта (scripts/ci-lighthouse.mjs)
.lighthouse/
dist/
.pio/

# Системные файлы
.DS_Store
Thumbs.db

# Корень CA Caddy, скачанный для телефона (README)
/root.crt
/caddy-root.crt
*.bundle
